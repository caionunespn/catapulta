{
  "rules": {
    "catapulta": {
      "rooms": {
        "$code": {
          ".write": "auth != null && (!data.exists() && newData.child('hostUid').val() === auth.uid || data.child('hostUid').val() === auth.uid)",
          "hostUid": {
            ".read": "auth != null",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "secret": {
            ".read": false,
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "createdAt": {
            ".read": "auth != null",
            ".validate": "newData.isNumber()"
          },
          "hostState": {
            ".read": "auth != null && root.child('catapulta/rooms').child($code).child('hostUid').val() === auth.uid",
            ".write": "auth != null && root.child('catapulta/rooms').child($code).child('hostUid').val() === auth.uid"
          },
          "public": {
            ".read": "auth != null",
            ".write": "auth != null && root.child('catapulta/rooms').child($code).child('hostUid').val() === auth.uid"
          },
          "views": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && root.child('catapulta/rooms').child($code).child('hostUid').val() === auth.uid"
            }
          },
          "inbox": {
            ".read": "auth != null && root.child('catapulta/rooms').child($code).child('hostUid').val() === auth.uid",
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('catapulta/rooms').child($code).child('hostUid').val() === auth.uid)",
              ".write": "auth != null && (auth.uid === $uid || root.child('catapulta/rooms').child($code).child('hostUid').val() === auth.uid) && (!newData.exists() || (newData.child('key').val() === root.child('catapulta/rooms').child($code).child('secret').val() && newData.child('t').isString() && newData.child('t').val().length <= 16 && newData.child('seq').isNumber()))"
            }
          }
        }
      }
    }
  }
}
